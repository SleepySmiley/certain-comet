---
import '../styles/global.css';

type ProjectEntry = {
  title: string;
  description: string;
  link?: string;
  linkLabel?: string;
  audioSrc?: string;
  actionLabel?: string;
};

type ProfileSection = {
  title: string;
  entries: ProjectEntry[];
};

type TimelineItem = {
  year: string;
  title: string;
  detail: string;
};

const profileSections: ProfileSection[] = [
  {
    title: 'Istruzione',
    entries: [
      {
        title: 'Percorso scolastico',
        description:
          'ITI Blaise Pascal Comandini, indirizzo informatico. Diploma attualmente in corso.\nHo consolidato basi di C# e sviluppo desktop con WPF.',
        link: 'https://www.ispascalcomandini.it/',
        linkLabel: 'Blaise Pascal'
      }
    ]
  },
  {
    title: 'Programmazione',
    entries: [
      {
        title: 'Sito web CV',
        description:
          'Curriculum online sviluppato con Astro e Tailwind, pensato per presentare profilo, progetti e contatti.\nHo scelto questo stack per costruire un layout moderno, veloce e facilmente estendibile.',
        link: 'https://github.com/SleepySmiley/CV',
        linkLabel: 'Project CV'
      },
      {
        title: 'App Conferenze',
        description:
          'Applicazione desktop per la gestione dei tempi di una riunione, sviluppata con C#, WPF e XAML.',
        link: 'https://github.com/SleepySmiley/InTempoFinalProject',
        linkLabel: 'InTime'
      }
    ]
  },
  {
    title: 'Produzione musicale',
    entries: [
      {
        title: 'Hard Jerky beat',
        description:
          'Una base musicale prodotta in FL Studio, con focus su sonorita trap e approccio sperimentale.\nQuesto progetto in particolare segue una direzione jerky.',
        audioSrc: '/audio/jerky-beat.wav',
        actionLabel: 'Riproduci beat'
      },
      {
        title: 'Chill Trap beat',
        description: 'Una base musicale prodotta in FL Studio, con focus su sonorita trap ma con pochi elementi e ordinati.\nQuesto infatti segue un ritmo lento ma incalzante.',
        audioSrc: '/audio/Chill-Trap.wav',
        actionLabel: 'Riproduci beat'
      },
      {
        title: 'Rap Hip Hop Beat',
        description: 'Una base musicale prodotta in FL Studio, con focus su sonorita rap con una varieta di batteria che gira intorno ad una semplice melodia.\nQuesto beat ha la caratteristica di avere un basso molto profondo e pieno',
        audioSrc: '/audio/Ele-A.wav',
        actionLabel: 'Riproduci beat'
      }

    ]
  },
  {
    title: 'Fotografia',
    entries: [
      {
        title: 'Progetto fotografico',
        description:
          'Spazio dedicato a shooting, editing, serie fotografiche e lavori personali costruiti con attenzione a composizione e luce.',
        link: '#',
        linkLabel: 'Aggiungi link'
      }
    ]
  }
];

const lifeTimeline: TimelineItem[] = [
  {
    year: '2008',
    title: 'Nato ad Abano Terme',
    detail: 'Inizio del mio percorso personale e formativo.'
  },
  {
    year: '2021',
    title: 'Scuole medie concluse',
    detail: 'Conseguite presso Istituto Aldo Moro.'
  },
  {
    year: '2022',
    title: 'Inizio produzione musicale',
    detail: 'Primi passi nella produzione musicale e studio di FL Studio.'
  },
  {
    year: '2023',
    title: 'Inizio fotografia',
    detail: 'Prime esperienze con fotografia, composizione e ricerca visiva.'
  },
  {
    year: '2024',
    title: 'Inizio programmazione attiva',
    detail: 'Avvio di progetti concreti e pratica costante nello sviluppo software.'
  },
  {
    year: '2026 - Oggi',
    title: 'Studente al Blaise Pascal Comandini',
    detail: 'Percorso in ambito informatico attualmente in corso.'
  },
  {
    year: 'Futuro',
    title: 'In cerca di lavoro',
    detail: 'Aperto a prime opportunita per crescere e mettermi in gioco.'
  }
];
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1120" />
    <title>Il mio CV - Christian Mattiolo</title>
  </head>

  <body class="relative flex min-h-screen items-center justify-center overflow-x-hidden bg-[radial-gradient(circle_at_top,#25344b_0%,#101827_44%,#090d16_100%)] p-4 font-sans antialiased md:p-8">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="absolute -top-24 left-[8%] h-72 w-72 rounded-full bg-amber-200/14 blur-[120px]"></div>
