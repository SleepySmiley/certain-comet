---
import '../styles/global.css';

type ProjectEntry = {
  title: string;
  description: string;
  link?: string;
  linkLabel?: string;
  audioSrc?: string;
  actionLabel?: string;
};

type ProfileSection = {
  title: string;
  entries: ProjectEntry[];
};

const profileSections: ProfileSection[] = [
  {
    title: 'Istruzione',
    entries: [
      {
        title: 'Percorso scolastico',
        description: 'ITI Blaise Pascal Comandini, indirizzo informatico. Diploma attualmente in corso.\nHo acquisito abili capacità in C# utilizzando WPF.',
        link: 'https://www.ispascalcomandini.it/',
        linkLabel: 'Blaise Pascal'
      }
    ]
  },
  {
    title: 'Programmazione',
    entries: [
      {
        title: 'Sito web CV',
        description: 'Curriculum online sviluppato con Astro e Tailwind, pensato per presentare un profilo, progetti e contatti.\nTailwind è uno dei framework CSS più in voga insieme ad Astro al momento e ho voluto utilizzarli proprio per questo sito ',
        link: 'https://github.com/SleepySmiley/CV',
        linkLabel: 'Project CV'
      },
      {
        title: 'App Conferenze',
        description: 'Una app funzionale e compatta per la gestione delle logiche di tempo di una riunione, il codice è fatto su wpf con utilizzo di C# e Xaml',
        link: 'https://github.com/SleepySmiley/InTempoFinalProject',
        linkLabel: 'InTime'
      }
    ]
  },
  {
    title: 'Produzione musicale',
    entries: [
      {
        title: 'Hard beat',
        description: 'Una delle tanti basi musicali che produco, principalmente produco trap ma ho molta dimestichezza con FL Studio e posso produrre un po tutti i generi\nQuesto in particolare è un beat trap jerky',
        audioSrc: '/public/audio/Jerky Beat.wav',
        actionLabel: 'Riproduci beat'
      }
    ]
  },
  {
    title: 'Fotografia',
    entries: [
      {
        title: 'Progetto fotografico',
        description: 'Sezione pronta per raccogliere shooting, editing, serie fotografiche o lavori personali.',
        link: '#',
        linkLabel: 'Aggiungi link'
      }
    ]
  }
];
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Il mio CV - Christian Mattiolo</title>
  </head>

  <body class="flex min-h-screen items-center justify-center bg-linear-to-br from-amber-400 via-orange-500 to-rose-500 p-4 font-sans antialiased md:p-8">
    <main class="mx-auto w-full max-w-5xl overflow-hidden rounded-3xl border border-white/30 bg-white/70 shadow-2xl ring-1 ring-white/40 backdrop-blur-xl">
      <header class="relative bg-linear-to-r from-orange-500/90 to-red-600/90 p-8 text-white md:p-12">
        <div class="pointer-events-none absolute top-0 right-0 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>

        <h1 class="relative z-10 text-4xl font-extrabold tracking-tight drop-shadow-sm md:text-6xl">Christian Mattiolo</h1>
        <p class="relative z-10 mt-2 text-xl font-medium text-orange-100">Studente / Aspirante Sviluppatore</p>

        <div class="relative z-10 mt-8 flex flex-wrap items-center gap-3 text-sm font-medium">
          <a
            href="https://www.google.it/maps/place/47025+Mercato+Saraceno+FC"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/20 bg-white/20 px-4 py-2 shadow-sm backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/30 hover:shadow-md"
          >
            <span aria-hidden="true">&#128205;</span>
            <span>Mercato Saraceno</span>
          </a>

          <a
            href="tel:+393923651045"
            class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/20 bg-white/20 px-4 py-2 shadow-sm backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/30 hover:shadow-md"
          >
            <span aria-hidden="true">&#128222;</span>
            <span>+39 3923651045</span>
          </a>

          <div class="group relative inline-block">
            <button
              type="button"
              class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/20 bg-white/20 px-4 py-2 shadow-sm backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/30 hover:shadow-md focus-visible:-translate-y-0.5 focus-visible:bg-white/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-orange-500"
              aria-haspopup="true"
              aria-controls="email-menu"
            >
              <span aria-hidden="true">&#128231;</span>
              <span>christianmattiolo@email.com &#9662;</span>
            </button>

            <div
              id="email-menu"
              class="invisible pointer-events-none absolute top-full left-0 z-50 w-56 origin-top-left scale-95 pt-3 opacity-0 transition-all duration-300 group-hover:pointer-events-auto group-hover:visible group-hover:scale-100 group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:visible group-focus-within:scale-100 group-focus-within:opacity-100"
            >
              <div class="flex flex-col gap-1 rounded-2xl border border-white/40 bg-white/90 p-2 shadow-2xl ring-1 ring-black/5 backdrop-blur-2xl">
                <a
                  href="mailto:christianmattiolo@email.com"
                  class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm text-slate-700 transition-colors hover:bg-orange-500/10 hover:text-orange-700"
                >
                  &#128241; Apri app predefinita
                </a>

                <a
                  href="https://mail.google.com/mail/?view=cm&fs=1&to=christianmattiolo@email.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm text-slate-700 transition-colors hover:bg-orange-500/10 hover:text-orange-700"
                >
                  &#127760; Apri Gmail
                </a>
              </div>
            </div>
          </div>

          <a
            href="https://github.com/SleepySmiley"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/20 bg-white/20 px-4 py-2 shadow-sm backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/30 hover:shadow-md"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.042-1.416-4.042-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.744.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            <span>SleepySmiley</span>
          </a>
        </div>
      </header>

      <div class="flex flex-col md:flex-row">
        <aside class="w-full border-r border-white/30 bg-white/40 p-8 backdrop-blur-lg md:w-[35%] md:p-10">
          <h2 class="mb-4 text-xs font-bold tracking-widest text-red-900/60 uppercase">Chi sono</h2>
          <p class="mb-10 text-base leading-relaxed font-medium text-slate-800">
            Ho 17 anni, ho una grande passione per l&apos;informatica e i mondi affini a questo. Insieme a questa passione produco
            anche musica e ho fatto fotografia.
          </p>

          <h2 class="mb-4 text-xs font-bold tracking-widest text-red-900/60 uppercase">Competenze</h2>
          <div class="flex flex-wrap gap-2">
            <span class="rounded-lg border border-white/40 bg-white/50 px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm backdrop-blur-md">HTML</span>
            <span class="rounded-lg border border-white/40 bg-white/50 px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm backdrop-blur-md">CSS</span>
            <span class="rounded-lg border border-white/40 bg-white/50 px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm backdrop-blur-md">Tailwind V4</span>
            <span class="rounded-lg border border-white/40 bg-white/50 px-3 py-1.5 text-xs font-bold text-slate-700 shadow-sm backdrop-blur-md">Astro</span>
          </div>
        </aside>

        <section class="w-full bg-white/60 p-8 backdrop-blur-lg md:w-[65%] md:p-12">
          <div class="mb-8 flex items-start justify-items-center gap-4">
            <div>
              <div class="flex items-center gap-3">
                <span class="h-3.5 w-3.5 rounded-full bg-orange-500 shadow-[0_0_0_6px_rgba(249,115,22,0.14)]"></span>
                <h2 class="text-2xl font-bold text-slate-900">Percorso</h2>
              </div>
            </div>
          </div>

          <div class="space-y-8">
            {profileSections.map((section, sectionIndex) => (
              <article class="border-l-2 border-orange-200/80 pl-5">
                <h3 class="text-2xl font-bold text-slate-900">{section.title}</h3>
                <div class="mt-4 space-y-3">
                  {section.entries.map((entry, entryIndex) => (
                    <div class="rounded-4xl border border-orange-200/70 bg-white/80 px-5 py-4 shadow-sm backdrop-blur-sm">
                      <div class="flex flex-col items-start gap-3">
                        <h4 class="text-lg font-bold text-slate-900">{entry.title}</h4>
                        <p class="text-sm leading-relaxed text-slate-600">{entry.description}</p>
                        {entry.audioSrc ? (
                          <>
                            <button
                              type="button"
                              class="inline-flex items-center justify-center gap-2 rounded-full border border-orange-300 bg-orange-100 px-4 py-2 text-sm font-semibold text-orange-700 transition-colors hover:bg-orange-200"
                              data-audio-toggle={`audio-${sectionIndex}-${entryIndex}`}
                              data-audio-label={entry.actionLabel}
                              aria-label={entry.actionLabel}
                            >
                              <span aria-hidden="true" data-audio-icon class="flex h-5 w-5 items-center justify-center">
                                <svg data-audio-play-icon class="h-4 w-4 translate-x-px fill-current" viewBox="0 0 16 16">
                                  <path d="M4 2.7v10.6c0 .6.7 1 1.2.7l8-5.3a.8.8 0 0 0 0-1.4l-8-5.3A.8.8 0 0 0 4 2.7Z"></path>
                                </svg>
                                <svg data-audio-pause-icon class="hidden h-4 w-4 fill-current" viewBox="0 0 16 16">
                                  <path d="M4 2.5h3v11H4zM9 2.5h3v11H9z"></path>
                                </svg>
                              </span>
                              <span data-audio-text>{entry.actionLabel}</span>
                            </button>
                            <audio id={`audio-${sectionIndex}-${entryIndex}`} preload="none" src={entry.audioSrc}></audio>
                          </>
                        ) : (
                          <a
                            href={entry.link ?? '#'}
                            target={entry.link && entry.link !== '#' ? '_blank' : undefined}
                            rel={entry.link && entry.link !== '#' ? 'noopener noreferrer' : undefined}
                            class="inline-flex items-center justify-center rounded-full border border-orange-300 bg-orange-100 px-4 py-2 text-sm font-semibold text-orange-700 transition-colors hover:bg-orange-200"
                          >
                            {entry.linkLabel ?? 'Apri progetto'}
                          </a>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      </div>
    </main>
    <script is:inline>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const button = target.closest('[data-audio-toggle]');
        if (!(button instanceof HTMLElement)) return;

        const audioId = button.dataset.audioToggle;
        if (!audioId) return;

        const audio = document.getElementById(audioId);
        if (!(audio instanceof HTMLAudioElement)) return;

        const playIcon = button.querySelector('[data-audio-play-icon]');
        const pauseIcon = button.querySelector('[data-audio-pause-icon]');
        const text = button.querySelector('[data-audio-text]');
        const baseLabel = button.dataset.audioLabel ?? 'Riproduci audio';

        document.querySelectorAll('audio').forEach((item) => {
          if (!(item instanceof HTMLAudioElement) || item === audio) return;

          item.pause();
          item.currentTime = 0;

          const relatedButton = document.querySelector(`[data-audio-toggle="${item.id}"]`);
          if (!(relatedButton instanceof HTMLElement)) return;

          const relatedPlayIcon = relatedButton.querySelector('[data-audio-play-icon]');
          const relatedPauseIcon = relatedButton.querySelector('[data-audio-pause-icon]');
          const relatedText = relatedButton.querySelector('[data-audio-text]');

          if (relatedPlayIcon instanceof SVGElement) relatedPlayIcon.classList.remove('hidden');
          if (relatedPauseIcon instanceof SVGElement) relatedPauseIcon.classList.add('hidden');
          if (relatedText) relatedText.textContent = relatedButton.dataset.audioLabel ?? 'Riproduci audio';
        });

        if (audio.paused) {
          void audio.play();
          if (playIcon instanceof SVGElement) playIcon.classList.add('hidden');
          if (pauseIcon instanceof SVGElement) pauseIcon.classList.remove('hidden');
          if (text) text.textContent = 'Metti in pausa';
        } else {
          audio.pause();
          if (playIcon instanceof SVGElement) playIcon.classList.remove('hidden');
          if (pauseIcon instanceof SVGElement) pauseIcon.classList.add('hidden');
          if (text) text.textContent = baseLabel;
        }

        audio.onended = () => {
          if (playIcon instanceof SVGElement) playIcon.classList.remove('hidden');
          if (pauseIcon instanceof SVGElement) pauseIcon.classList.add('hidden');
          if (text) text.textContent = baseLabel;
        };
      });
    </script>
  </body>
</html>
