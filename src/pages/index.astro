      <div class="absolute inset-0 opacity-35 bg-[linear-gradient(rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-size-[120px_120px] mask-[radial-gradient(circle_at_center,black,transparent_78%)]"></div>
    </div>

    <main class="glass-panel relative z-10 mx-auto w-full max-w-5xl overflow-visible rounded-4xl border border-white/12 bg-white/8 shadow-[0_32px_90px_rgba(2,6,23,0.52)] ring-1 ring-white/10 backdrop-blur-[30px]">
