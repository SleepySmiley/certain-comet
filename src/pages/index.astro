          <a
            href="https://github.com/SleepySmiley"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/8 px-4 py-2 shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/12 hover:shadow-[0_10px_30px_rgba(2,6,23,0.22)]"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.042-1.416-4.042-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.744.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            <span>SleepySmiley</span>
          </a>
        </div>
      </header>

      <div class="overflow-hidden rounded-b-4xl flex flex-col md:flex-row">
        <aside class="bg-white/4.5 p-8 backdrop-blur-xl md:w-[35%] md:border-r md:border-white/10 md:p-10 md:rounded-bl-4xl">
          <h2 class="mb-4 text-[11px] font-bold tracking-[0.28em] text-white/44 uppercase">Profilo</h2>
          <p class="mb-10 text-base leading-relaxed font-medium text-slate-200/80">
            Ho 17 anni e una forte passione per l&apos;informatica. Accanto allo sviluppo software coltivo anche produzione musicale e
            fotografia, due ambiti che mi aiutano a costruire sensibilita tecnica e visiva.
          </p>

          <h2 class="mb-4 text-[11px] font-bold tracking-[0.28em] text-white/44 uppercase">Competenze</h2>
          <div class="flex flex-wrap gap-2">
            <span class="rounded-full border border-white/12 bg-white/6 px-3 py-1.5 text-[11px] font-semibold tracking-[0.18em] text-slate-100/88 uppercase shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-md">HTML</span>
            <span class="rounded-full border border-white/12 bg-white/6 px-3 py-1.5 text-[11px] font-semibold tracking-[0.18em] text-slate-100/88 uppercase shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-md">CSS</span>
            <span class="rounded-full border border-white/12 bg-white/6 px-3 py-1.5 text-[11px] font-semibold tracking-[0.18em] text-slate-100/88 uppercase shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-md">Tailwind</span>
            <span class="rounded-full border border-white/12 bg-white/6 px-3 py-1.5 text-[11px] font-semibold tracking-[0.18em] text-slate-100/88 uppercase shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-md">Astro</span>
            <span class="rounded-full border border-white/12 bg-white/6 px-3 py-1.5 text-[11px] font-semibold tracking-[0.18em] text-slate-100/88 uppercase shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-md">C#</span>
            <span class="rounded-full border border-white/12 bg-white/6 px-3 py-1.5 text-[11px] font-semibold tracking-[0.18em] text-slate-100/88 uppercase shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-md">WPF</span>
          </div>

          <div class="mt-12">
            <h2 class="mb-5 text-[11px] font-bold tracking-[0.28em] text-white/44 uppercase">Timeline</h2>
            <div class="relative space-y-5 pl-6">
              <div class="pointer-events-none absolute top-1 bottom-1 left-2.25 w-px bg-linear-to-b from-amber-200/0 via-amber-200/45 to-white/0"></div>

              {lifeTimeline.map((item) => (
                <article class="relative">
                  <span class="absolute top-1 -left-6 h-2.75 w-2.75 rounded-full border border-amber-200/50 bg-amber-300 shadow-[0_0_0_5px_rgba(251,191,36,0.08)]"></span>
                  <p class="text-[11px] font-semibold tracking-[0.2em] text-amber-100/70 uppercase">{item.year}</p>
                  <h3 class="mt-1 text-sm font-semibold text-white">{item.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-300/72">{item.detail}</p>
                </article>
              ))}
            </div>
          </div>
        </aside>

        <section class="rounded-b-4xl bg-white/3 p-8 backdrop-blur-xl md:w-[65%] md:rounded-br-4xl md:rounded-bl-none md:p-12">
          <div class="mb-10 flex items-start gap-4">
            <div>
              <div class="flex items-center gap-3">
                <span class="h-3 w-3 rounded-full bg-amber-300 shadow-[0_0_0_7px_rgba(251,191,36,0.12)]"></span>
                <h2 class="text-2xl font-bold tracking-tight text-white">Percorso</h2>
              </div>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300/72">
                Una selezione di esperienze formative e progetti personali che raccontano il mio percorso tra tecnologia e creativita.
              </p>
            </div>
          </div>

          <div class="space-y-10">
            {profileSections.map((section, sectionIndex) => (
              <article class="border-l border-white/12 pl-6">
                <h3 class="text-2xl font-bold tracking-tight text-white">{section.title}</h3>
                <div class="mt-5 space-y-4">
                  {section.entries.map((entry, entryIndex) => (
                    <div class="glass-card rounded-[28px] border border-white/12 bg-white/6 px-5 py-5 shadow-[0_18px_40px_rgba(2,6,23,0.24)] backdrop-blur-xl">
                      <div class="flex flex-col items-start gap-3">
                        <h4 class="text-lg font-bold tracking-tight text-white">{entry.title}</h4>
                        <p class="max-w-2xl whitespace-pre-line text-sm leading-relaxed text-slate-300/78">{entry.description}</p>
                        {entry.audioSrc ? (
                          <>
                            <button
                              type="button"
                              class="inline-flex items-center justify-center gap-2 rounded-full border border-amber-200/22 bg-amber-200/10 px-4 py-2 text-sm font-semibold text-amber-100 transition-colors hover:bg-amber-200/16"
                              data-audio-toggle={`audio-${sectionIndex}-${entryIndex}`}
                              data-audio-label={entry.actionLabel}
                              aria-label={entry.actionLabel}
                            >
                              <span aria-hidden="true" data-audio-icon class="flex h-5 w-5 items-center justify-center">
                                <svg data-audio-play-icon class="h-4 w-4 translate-x-px fill-current" viewBox="0 0 16 16">
                                  <path d="M4 2.7v10.6c0 .6.7 1 1.2.7l8-5.3a.8.8 0 0 0 0-1.4l-8-5.3A.8.8 0 0 0 4 2.7Z"></path>
                                </svg>
                                <svg data-audio-pause-icon class="hidden h-4 w-4 fill-current" viewBox="0 0 16 16">
                                  <path d="M4 2.5h3v11H4zM9 2.5h3v11H9z"></path>
                                </svg>
                              </span>
                              <span data-audio-text>{entry.actionLabel}</span>
                            </button>
                            <audio id={`audio-${sectionIndex}-${entryIndex}`} preload="none" src={entry.audioSrc}></audio>
                          </>
                        ) : (
                          <a
                            href={entry.link ?? '#'}
                            target={entry.link && entry.link !== '#' ? '_blank' : undefined}
                            rel={entry.link && entry.link !== '#' ? 'noopener noreferrer' : undefined}
                            class="inline-flex items-center justify-center rounded-full border border-white/12 bg-white/8 px-4 py-2 text-sm font-semibold text-slate-100 transition-colors hover:bg-white/12"
                          >
                            {entry.linkLabel ?? 'Apri progetto'}
                          </a>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      </div>
    </main>

    <script is:inline>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const emailDropdown = document.querySelector('[data-email-dropdown]');
        const emailToggle = document.querySelector('[data-email-toggle]');
        const emailMenu = document.querySelector('[data-email-menu]');

        if (
          emailDropdown instanceof HTMLElement &&
          emailToggle instanceof HTMLElement &&
          emailMenu instanceof HTMLElement
        ) {
          const clickedToggle = target.closest('[data-email-toggle]');
          const clickedInsideMenu = target.closest('[data-email-menu]');

          if (clickedToggle) {
            const isOpen = emailToggle.getAttribute('aria-expanded') === 'true';
            emailToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
            emailMenu.classList.toggle('invisible', isOpen);
            emailMenu.classList.toggle('pointer-events-none', isOpen);
            emailMenu.classList.toggle('opacity-0', isOpen);
            emailMenu.classList.toggle('scale-95', isOpen);
            emailMenu.classList.toggle('visible', !isOpen);
            emailMenu.classList.toggle('pointer-events-auto', !isOpen);
            emailMenu.classList.toggle('opacity-100', !isOpen);
            emailMenu.classList.toggle('scale-100', !isOpen);
            return;
          }

          if (!clickedInsideMenu && !target.closest('[data-email-dropdown]')) {
            emailToggle.setAttribute('aria-expanded', 'false');
            emailMenu.classList.add('invisible', 'pointer-events-none', 'opacity-0', 'scale-95');
            emailMenu.classList.remove('visible', 'pointer-events-auto', 'opacity-100', 'scale-100');
          }
        }

        const button = target.closest('[data-audio-toggle]');
        if (!(button instanceof HTMLElement)) return;

        const audioId = button.dataset.audioToggle;
        if (!audioId) return;

        const audio = document.getElementById(audioId);
        if (!(audio instanceof HTMLAudioElement)) return;

        const playIcon = button.querySelector('[data-audio-play-icon]');
        const pauseIcon = button.querySelector('[data-audio-pause-icon]');
        const text = button.querySelector('[data-audio-text]');
        const baseLabel = button.dataset.audioLabel ?? 'Riproduci audio';

        document.querySelectorAll('audio').forEach((item) => {
          if (!(item instanceof HTMLAudioElement) || item === audio) return;

          item.pause();
          item.currentTime = 0;

          const relatedButton = document.querySelector(`[data-audio-toggle="${item.id}"]`);
          if (!(relatedButton instanceof HTMLElement)) return;

          const relatedPlayIcon = relatedButton.querySelector('[data-audio-play-icon]');
          const relatedPauseIcon = relatedButton.querySelector('[data-audio-pause-icon]');
          const relatedText = relatedButton.querySelector('[data-audio-text]');

          if (relatedPlayIcon instanceof SVGElement) relatedPlayIcon.classList.remove('hidden');
          if (relatedPauseIcon instanceof SVGElement) relatedPauseIcon.classList.add('hidden');
          if (relatedText) relatedText.textContent = relatedButton.dataset.audioLabel ?? 'Riproduci audio';
        });

        if (audio.paused) {
          void audio.play();
          if (playIcon instanceof SVGElement) playIcon.classList.add('hidden');
          if (pauseIcon instanceof SVGElement) pauseIcon.classList.remove('hidden');
          if (text) text.textContent = 'Metti in pausa';
        } else {
          audio.pause();
          if (playIcon instanceof SVGElement) playIcon.classList.remove('hidden');
          if (pauseIcon instanceof SVGElement) pauseIcon.classList.add('hidden');
          if (text) text.textContent = baseLabel;
        }

        audio.onended = () => {
          if (playIcon instanceof SVGElement) playIcon.classList.remove('hidden');
          if (pauseIcon instanceof SVGElement) pauseIcon.classList.add('hidden');
          if (text) text.textContent = baseLabel;
        };
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        const emailToggle = document.querySelector('[data-email-toggle]');
        const emailMenu = document.querySelector('[data-email-menu]');

        if (!(emailToggle instanceof HTMLElement) || !(emailMenu instanceof HTMLElement)) return;

        emailToggle.setAttribute('aria-expanded', 'false');
        emailMenu.classList.add('invisible', 'pointer-events-none', 'opacity-0', 'scale-95');
        emailMenu.classList.remove('visible', 'pointer-events-auto', 'opacity-100', 'scale-100');
      });
    </script>
  </body>
</html>
