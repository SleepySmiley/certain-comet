      <div class="absolute top-[42%] -left-32 h-72 w-72 rounded-full bg-white/8 blur-[150px]"></div>
      <div class="absolute top-[56%] right-[6%] h-64 w-64 rounded-full bg-white/10 blur-[140px]"></div>
