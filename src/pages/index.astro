              class="inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/8 px-4 py-2 shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/12 hover:shadow-[0_10px_30px_rgba(2,6,23,0.22)] focus-visible:-translate-y-0.5 focus-visible:bg-white/16 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900/60"
